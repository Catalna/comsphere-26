# Copy to .env for local development and fill in values locally. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgres://danaterang_dev:URL_ENCODED_LOCAL_PASSWORD@127.0.0.1:5432/danaterang
WEB_ORIGIN=http://localhost:3000
AUTO_MIGRATE=false
LOCAL_OBJECT_STORAGE_ROOT=../.local/evidence
MAX_EVIDENCE_BYTES=10485760
STORAGE_MODE=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Local folder containing uncompressed eng.traineddata and ind.traineddata; keep model files untracked.
OCR_LANGUAGE_DATA_PATH=../.local/tessdata
OCR_POLL_INTERVAL_MS=1000
OCR_JOB_LEASE_MS=300000
OCR_MAX_ATTEMPTS=3
OCR_MAX_PDF_PAGES=10
OCR_RENDER_DPI=150
OCR_MAX_IMAGE_PIXELS=25000000
OCR_VENDOR_CONFIDENCE_THRESHOLD=70
OCR_DOCUMENT_DATE_CONFIDENCE_THRESHOLD=80
OCR_AMOUNT_CONFIDENCE_THRESHOLD=90
OCR_INVOICE_CONFIDENCE_THRESHOLD=70

# Ethereum Sepolia service wallet; set only in a private local .env or staging secret store.
PEER_REVIEW_CONTRACT_ADDRESS=
# ProofAnchor contract for canonical proof commitments; anchoring stays disabled when unset.
PROOF_ANCHOR_CONTRACT_ADDRESS=
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
# The initial three Verifier addresses and Organization commitments are fixed in the contract constructor.
CONTRACT_ADDRESS=
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_EXPLORER_URL=https://sepolia.etherscan.io

# Used only by `npm run admin:provision --workspace @dana-terang/api`.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
